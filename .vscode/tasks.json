{
  "version": "2.0.0",
  "options": {
    "env": {
      "PATH": "C:/Qt/Qt5.14.2/5.14.2/mingw73_64/bin;C:/Qt/Qt5.14.2/Tools/mingw730_64/bin;${env:PATH}"
    }
  },
  "tasks": [
    {
      "label": "cmake-configure",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S", "${workspaceFolder}",
        "-B", "${workspaceFolder}/build",
        "-G", "MinGW Makefiles",
        "-DCMAKE_PREFIX_PATH=C:/Qt/Qt5.14.2/5.14.2/mingw73_64",
        "-DCMAKE_MAKE_PROGRAM=C:/Qt/Qt5.14.2/Tools/mingw730_64/bin/mingw32-make.exe",
        "-DCMAKE_BUILD_TYPE=Debug"
      ],
      "problemMatcher": [],
      "detail": "首次或修改 CMakeLists 后执行；生成 build/Makefile"
    },
    {
      "label": "build-all",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "${workspaceFolder}/build", "-j", "8"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"],
      "dependsOn": "cmake-configure",
      "detail": "编译 core + test_comm（依赖 cmake-configure）"
    },
    {
      "label": "build-core",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "${workspaceFolder}/build", "--target", "NewAntiDrone_core", "-j", "8"],
      "group": "build",
      "problemMatcher": ["$gcc"],
      "dependsOn": "cmake-configure",
      "detail": "仅编译 core"
    },
    {
      "label": "build-test_comm",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "${workspaceFolder}/build", "--target", "test_comm", "-j", "8"],
      "group": "build",
      "problemMatcher": ["$gcc"],
      "dependsOn": "cmake-configure",
      "detail": "仅编译 test_comm"
    },
    {
      "label": "clean",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "${workspaceFolder}/build", "--target", "clean"],
      "problemMatcher": [],
      "detail": "清理 CMake 产物（保留缓存）"
    },
    {
      "label": "wipe-build",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-Command",
        "if (Test-Path '${workspaceFolder}/build') { Remove-Item '${workspaceFolder}/build' -Recurse -Force }"
      ],
      "problemMatcher": [],
      "detail": "彻底删除 build/ 目录（含 cmake 缓存），下次需重新 configure"
    }
  ]
}
