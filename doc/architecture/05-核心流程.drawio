<mxCell id="s5" value="⑤ DeviceInfo + runtime state（聚合）" style="endArrow=open;endFill=0;html=1;fontSize=10;strokeColor=#82b366;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="397" y="310" as="sourcePoint"/><mxPoint x="237" y="310" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="s6" value="⑥ fixed Device DTO" style="endArrow=open;endFill=0;html=1;fontSize=10;strokeColor=#6c8ebf;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="237" y="355" as="sourcePoint"/><mxPoint x="82" y="355" as="targetPoint"/></mxGeometry></mxCell>

<mxCell id="note" value="&lt;b&gt;设计说明&lt;/b&gt;&#xa;· 前端加载后端设备台账，不维护本地设备缓存&#xa;· 通信端点由 endpoints.json 配置驱动，DeviceEndpointBinding 为多对多关联&#xa;· 对外暴露 fixed Device DTO，Web 层不感知内部 binding 结构" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="30" y="490" width="850" height="70" as="geometry"/></mxCell>

