  <mxGeometry x="84" y="1093" width="780" height="10" as="geometry"/>
</mxCell>
<mxCell id="note-mapping" value="代码映射：Web=React  |  总控=AppController  |  通信=CommunicationManager  |  DataProcessor=RadarDataProcessor  |  设备台账=DeviceRegistry+SQLite  |  航迹显示=TrackDisplayManager  |  日志=Logger" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#999999;fontFamily=Helvetica;fontSize=10;align=left;fontStyle=2;" vertex="1" parent="1">
  <mxGeometry x="84" y="1107" width="780" height="36" as="geometry"/>
